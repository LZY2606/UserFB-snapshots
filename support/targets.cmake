if(EXISTS "${PROJECT_SOURCE_DIR}/support/target_cases.cpp")
  enable_language(CXX)
endif()
# Deferred so chdr-static and CHDR_DEFINES have been declared.
function(targets)
  add_executable(baseline "${PROJECT_SOURCE_DIR}/support/baseline.c")
  target_link_libraries(baseline PRIVATE chdr-static)
  target_include_directories(baseline PRIVATE "${PROJECT_SOURCE_DIR}/include")
  if(EXISTS "${PROJECT_SOURCE_DIR}/support/target_cases.cpp")
    add_executable(target "${PROJECT_SOURCE_DIR}/support/target_main.cpp")
    target_compile_features(target PRIVATE cxx_std_11)
    target_include_directories(target PRIVATE "${PROJECT_SOURCE_DIR}/include")
    target_link_libraries(target PRIVATE chdr-static)
  endif()
endfunction()
cmake_language(DEFER CALL targets)
