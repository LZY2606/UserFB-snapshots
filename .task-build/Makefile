	$(MAKE) $(MAKESILENT) -f CMakeFiles/motion_baseline.dir/build.make CMakeFiles/motion_baseline.dir/baseline.cpp.i
.PHONY : baseline.cpp.i

baseline.s: baseline.cpp.s
.PHONY : baseline.s

# target to generate assembly for a file
baseline.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/motion_baseline.dir/build.make CMakeFiles/motion_baseline.dir/baseline.cpp.s
.PHONY : baseline.cpp.s

